$TTL 60
@          IN SOA    ns.internal.polpetta.online. billy. (
                        2026103101 ; serial (YYYYMMDDnn) — bump on changes
                        1h         ; refresh
                        15m        ; retry
                        1w         ; expire
                        1h )       ; negative caching

           IN NS    ns.internal.polpetta.online.

ns         IN A     192.168.2.21

; The homepage (sites/homepage), self-hosted on the nginx container: explicit
; because the wildcard does not match the apex. Same target as the wildcard.
@          IN A     192.168.2.21

www        IN CNAME polpetta.online.
quote-book IN CNAME cname.vercel-dns.com.

*          IN A     192.168.2.21

external   IN A     87.106.25.93

; DERP relay + STUN (derper on vps-proxy). Explicit so the wildcard above
; does not shadow it; must match the public (DNS-only) record.
derp       IN A     87.106.25.93
