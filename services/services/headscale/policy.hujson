{
  "hosts": {
    "tailnet-v6": "fd7a:115c:a1e0::/48",
  },
  "groups": {
    "group:admin": ["jack@"],
  },

  // Keep access to the existing tailnet, serverone subnet and public exit
  // traffic. Never allow *:* or a range that includes the admin IP to everyone.
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["100.64.0.0/10:*", "tailnet-v6:*", "10.0.1.0/24:*", "192.168.2.0/24:*", "autogroup:internet:*"],
    },
    {
      "action": "accept",
      "src": ["group:admin"],
      "dst": ["@adminAddress@:443"],
      "proto": "tcp",
    },
  ],

  "tagOwners": {
    "tag:idp": ["jack@"],
    // Only a Headscale operator should assign this infrastructure tag.
    "tag:serverone": [],
  },
  "autoApprovers": {
    "routes": {
      "@adminAddress@/32": ["tag:serverone"],
    },
  },
  "grants": [
    {
      "src": ["jack@"],
      "dst": ["tag:idp"],
      "app": {
        "tailscale.com/cap/tsidp": [
          {
            "allow_admin_ui": true,
            "allow_dcr": true,
            "includeInUserInfo": true,
            "extraClaims": { "grafana_role": "Admin" },
          },
        ],
      },
    },
  ],

  "tests": [
    { "src": "jack@", "accept": ["@adminAddress@:443"], "deny": ["@adminAddress@:8443"] },
    { "src": "luke@", "accept": ["10.0.1.6:443", "10.0.1.11:53"], "deny": ["@adminAddress@:443"] },
    { "src": "edo@", "deny": ["@adminAddress@:443"] },
    { "src": "costi@", "deny": ["@adminAddress@:443"] },
    { "src": "tag:idp", "deny": ["@adminAddress@:443"] },
    { "src": "tag:serverone", "deny": ["@adminAddress@:443"] },
  ],
}
