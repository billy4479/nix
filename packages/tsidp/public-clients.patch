+// newPublicClientAuthRequest returns a fresh AuthRequest for the OpenCloud
+// style public client flow (authorization code + PKCE S256).
+func newPublicClientAuthRequest(fc *FunnelClient) *AuthRequest {
+	return &AuthRequest{
+		FunnelRP:            fc,
+		ClientID:            fc.ID,
+		RedirectURI:         fc.RedirectURIs[0],
+		Scopes:              []string{"openid"},
+		CodeChallenge:       "",
+		CodeChallengeMethod: "",
+		RemoteUser:          testRemoteUser(),
+		ValidTill:           time.Now().Add(5 * time.Minute),
+	}
+}
