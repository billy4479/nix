+// TestMetadataAdvertisesNone tests that the discovery documents advertise
+// support for the "none" token endpoint auth method, which the token endpoint
+// implements for public PKCE clients.
+func TestMetadataAdvertisesNone(t *testing.T) {
+	s := &IDPServer{
+		serverURL:   "https://idp.test.ts.net",
+		loopbackURL: "http://localhost:8080",
+	}
+
+	tests := []struct {
+		name     string
+		endpoint string
+		serveFn  func(http.ResponseWriter, *http.Request)
+	}{
+		{
+			name:     "OpenID Connect metadata",
+			endpoint: "/.well-known/openid-configuration",
+			serveFn:  s.serveOpenIDConfig,
+		},
+		{
+			name:     "OAuth 2.0 metadata",
+			endpoint: "/.well-known/oauth-authorization-server",
+			serveFn:  s.serveOAuthMetadata,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			req := httptest.NewRequest("GET", tt.endpoint, nil)
+			req.RemoteAddr = "127.0.0.1:12345"
+			rr := httptest.NewRecorder()
+			tt.serveFn(rr, req)
+
+			var metadata map[string]any
+			if err := json.Unmarshal(rr.Body.Bytes(), &metadata); err != nil {
+				t.Fatalf("failed to unmarshal metadata: %v", err)
+			}
+
+			methods, ok := metadata["token_endpoint_auth_methods_supported"].([]any)
+			if !ok {
+				t.Fatal("token_endpoint_auth_methods_supported not found or wrong type")
+			}
+
+			found := false
+			for _, m := range methods {
+				if s, ok := m.(string); ok && s == "none" {
+					found = true
+					break
+				}
+			}
+			if !found {
+				t.Errorf("expected %q in token_endpoint_auth_methods_supported, got %v", "none", methods)
+			}
+		})
+	}
+}
