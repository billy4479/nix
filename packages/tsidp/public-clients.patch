+// registerDCRClient POSTs the given JSON registration body to /register and
+// returns both the raw RFC 7591 response document and the stored FunnelClient.
+func registerDCRClient(t *testing.T, body string) (map[string]any, *FunnelClient) {
+	t.Helper()
+
+	s := &IDPServer{
+		serverURL:         "https://idp.test.ts.net",
+		stateDir:          t.TempDir(),
+		funnelClients:     make(map[string]*FunnelClient),
+		bypassAppCapCheck: true,
+	}
+
+	req := httptest.NewRequest("POST", "/register", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	rr := httptest.NewRecorder()
+	s.ServeHTTP(rr, req)
+
+	if rr.Code != http.StatusCreated {
+		t.Fatalf("POST /register status = %d, want 201: %s", rr.Code, rr.Body.String())
+	}
+
+	var raw map[string]any
+	if err := json.Unmarshal(rr.Body.Bytes(), &raw); err != nil {
+		t.Fatalf("failed to unmarshal registration response: %v", err)
+	}
+
+	id, ok := raw["client_id"].(string)
+	if !ok || id == "" {
+		t.Fatalf("registration response has no client_id: %s", rr.Body.String())
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	client, ok := s.funnelClients[id]
+	if !ok {
+		t.Fatalf("client %s not stored after registration", id)
+	}
+	return raw, client
+}
