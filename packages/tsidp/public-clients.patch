+// TestAllowRelyingPartyPublicClient tests that allowRelyingParty accepts
+// secret-less requests (public clients) only when the registered client has
+// no secret of its own, the authorization request carried a PKCE S256
+// challenge and the client_id matches. A client holding a registered secret
+// must keep presenting it.
+func TestAllowRelyingPartyPublicClient(t *testing.T) {
+	const (
+		clientID = "test-client"
+		secret   = "generated-secret"
+	)
+
+	tests := []struct {
+		name string
+		// authorization request state
+		codeChallenge       string
+		codeChallengeMethod string
+		// registered client state
+		hasRegisteredSecret bool
+		// token request state
+		clientIDForm     string
+		clientSecretForm string
+		wantStatus       int
+	}{
+		{
+			name:                "no secret registered, PKCE S256, no secret sent",
+			codeChallenge:       testCodeChallenge(t),
+			codeChallengeMethod: "S256",
+			clientIDForm:        clientID,
+			wantStatus:          http.StatusOK,
+		},
+		{
+			name:         "public client without PKCE",
+			clientIDForm: clientID,
+			wantStatus:   http.StatusUnauthorized,
+		},
+		{
+			name:                "public client with plain PKCE",
+			codeChallenge:       testCodeVerifier,
+			codeChallengeMethod: "plain",
+			clientIDForm:        clientID,
+			wantStatus:          http.StatusUnauthorized,
+		},
+		{
+			name:       "public client without client_id",
+			wantStatus: http.StatusUnauthorized,
+		},
+		{
+			name:                "public client with wrong client_id",
+			codeChallenge:       testCodeChallenge(t),
+			codeChallengeMethod: "S256",
+			clientIDForm:        "other-client",
+			wantStatus:          http.StatusBadRequest,
+		},
+		{
+			name:                "registered secret exists but is not sent, PKCE S256",
+			codeChallenge:       testCodeChallenge(t),
+			codeChallengeMethod: "S256",
+			hasRegisteredSecret: true,
+			clientIDForm:        clientID,
+			wantStatus:          http.StatusUnauthorized,
+		},
+		{
+			name:                "confidential client with correct secret",
+			hasRegisteredSecret: true,
+			clientIDForm:        clientID,
+			clientSecretForm:    secret,
+			wantStatus:          http.StatusOK,
+		},
+		{
+			name:                "confidential client with wrong secret",
+			hasRegisteredSecret: true,
+			clientIDForm:        clientID,
+			clientSecretForm:    "wrong-secret",
+			wantStatus:          http.StatusUnauthorized,
+		},
+		{
+			name:                "public client with a stray client_secret takes the public path",
+			codeChallenge:       testCodeChallenge(t),
+			codeChallengeMethod: "S256",
+			clientIDForm:        clientID,
+			clientSecretForm:    "stray-secret",
+			wantStatus:          http.StatusOK,
+		},
+		{
+			name:       "no credentials at all",
+			wantStatus: http.StatusUnauthorized,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			fc := &FunnelClient{ID: clientID}
+			if tt.hasRegisteredSecret {
+				fc.Secret = secret
+			}
+			ar := &AuthRequest{
+				FunnelRP:            fc,
+				ClientID:            clientID,
+				CodeChallenge:       tt.codeChallenge,
+				CodeChallengeMethod: tt.codeChallengeMethod,
+			}
+
+			form := url.Values{
+				"grant_type": {"authorization_code"},
+			}
+			if tt.clientIDForm != "" {
+				form.Set("client_id", tt.clientIDForm)
+			}
+			if tt.clientSecretForm != "" {
+				form.Set("client_secret", tt.clientSecretForm)
+			}
+
+			status, err := ar.allowRelyingParty(postTokenForm(form))
+			if status != tt.wantStatus {
+				t.Errorf("allowRelyingParty() status = %d, want %d (err: %v)", status, tt.wantStatus, err)
+			}
+			if tt.wantStatus == http.StatusOK && err != nil {
+				t.Errorf("allowRelyingParty() unexpected error for want OK: %v", err)
+			}
+		})
+	}
+}
