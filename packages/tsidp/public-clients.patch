+// TestDCRPublicClientRegistration tests that DCR with
+// token_endpoint_auth_method "none" registers a secret-less client, and that
+// per RFC 7591 the response echoes the auth method with no client_secret.
+func TestDCRPublicClientRegistration(t *testing.T) {
+	raw, client := registerDCRClient(t, `{
+		"redirect_uris": ["https://cloud.example.com/oauth2-redirect", "http://localhost:9200/oauth2-redirect"],
+		"client_name": "opencloud",
+		"token_endpoint_auth_method": "none",
+		"grant_types": ["authorization_code", "refresh_token"],
+		"response_types": ["code"],
+		"scope": "openid profile email"
+	}`)
+
+	if _, ok := raw["client_secret"]; ok {
+		t.Error("expected no client_secret field in the response for a public client")
+	}
+	if got, want := raw["token_endpoint_auth_method"], "none"; got != want {
+		t.Errorf("token_endpoint_auth_method = %v, want %v", got, want)
+	}
+	if client.Secret != "" {
+		t.Errorf("stored Secret = %q, want empty for a public client", client.Secret)
+	}
+	if client.TokenEndpointAuthMethod != "none" {
+		t.Errorf("stored TokenEndpointAuthMethod = %q, want %q", client.TokenEndpointAuthMethod, "none")
+	}
+	if !client.DynamicallyRegistered {
+		t.Error("expected dynamically_registered to be true")
+	}
+}
