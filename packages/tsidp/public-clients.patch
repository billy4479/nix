+func testRemoteUser() *apitype.WhoIsResponse {
+	return &apitype.WhoIsResponse{
+		Node: &tailcfg.Node{
+			ID:   1,
+			Name: "node1.example.ts.net",
+			User: tailcfg.UserID(1),
+		},
+		UserProfile: &tailcfg.UserProfile{
+			LoginName: "user@example.com",
+		},
+	}
+}
