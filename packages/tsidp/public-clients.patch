+// TestAuthorizationCodeGrantPublicClient runs the full authorization code
+// grant through serveToken for a public client: the token request sends no
+// client_secret, only client_id and code_verifier.
+func TestAuthorizationCodeGrantPublicClient(t *testing.T) {
+	const (
+		code        = "test-code"
+		redirectURI = "https://example.com/callback"
+	)
+
+	s := New(nil, "", false, false, false)
+	// A public client: registered with no secret at all.
+	s.funnelClients["test-client"] = &FunnelClient{
+		ID:           "test-client",
+		RedirectURIs: []string{redirectURI},
+	}
+
+	tests := []struct {
+		name        string
+		pkce        bool
+		code        string
+		verifier    string
+		wantStatus  int
+		wantErrText string
+	}{
+		{
+			name:       "valid code_verifier succeeds",
+			pkce:       true,
+			code:       code,
+			verifier:   testCodeVerifier,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:        "missing code_verifier fails",
+			pkce:        true,
+			code:        code,
+			wantStatus:  http.StatusBadRequest,
+			wantErrText: "code_verifier is required",
+		},
+		{
+			name:        "wrong code_verifier fails",
+			pkce:        true,
+			code:        code,
+			verifier:    "wrong-verifier-wrong-verifier-wrong-verifier-wrong",
+			wantStatus:  http.StatusBadRequest,
+			wantErrText: "code verification failed",
+		},
+		{
+			name:        "secret-less request without PKCE fails",
+			code:        code,
+			verifier:    testCodeVerifier,
+			wantStatus:  http.StatusUnauthorized,
+			wantErrText: "invalid_client",
+		},
+		{
+			name:        "unknown code fails",
+			pkce:        true,
+			code:        "unknown-code",
+			verifier:    testCodeVerifier,
+			wantStatus:  http.StatusBadRequest,
+			wantErrText: "code not found",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			// serveToken consumes the stored AuthRequest; insert a fresh one
+			// for every subtest.
+			ar := newPublicClientAuthRequest(s.funnelClients["test-client"])
+			if tt.pkce {
+				ar.CodeChallenge = testCodeChallenge(t)
+				ar.CodeChallengeMethod = "S256"
+			}
+			s.mu.Lock()
+			s.code[code] = ar
+			s.mu.Unlock()
+
+			form := url.Values{
+				"grant_type":   {"authorization_code"},
+				"code":         {tt.code},
+				"redirect_uri": {redirectURI},
+				"client_id":    {"test-client"},
+			}
+			if tt.verifier != "" {
+				form.Set("code_verifier", tt.verifier)
+			}
+
+			rr := httptest.NewRecorder()
+			s.serveToken(rr, postTokenForm(form))
+
+			if rr.Code != tt.wantStatus {
+				t.Errorf("expected status %d, got %d: %s", tt.wantStatus, rr.Code, rr.Body.String())
+			}
+			if tt.wantErrText != "" && !strings.Contains(rr.Body.String(), tt.wantErrText) {
+				t.Errorf("expected error containing %q, got %q", tt.wantErrText, rr.Body.String())
+			}
+			if tt.wantStatus == http.StatusOK {
+				var tokenResp oidcTokenResponse
+				if err := json.Unmarshal(rr.Body.Bytes(), &tokenResp); err != nil {
+					t.Fatalf("failed to unmarshal token response: %v", err)
+				}
+				if tokenResp.IDToken == "" || tokenResp.AccessToken == "" {
+					t.Errorf("expected non-empty id_token and access_token, got %q / %q", tokenResp.IDToken, tokenResp.AccessToken)
+				}
+			}
+		})
+	}
+}
