+const (
+	// testCodeVerifier is a valid PKCE code_verifier (43 unreserved characters).
+	testCodeVerifier = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopq"
+)
+
+// testCodeChallenge computes the S256 challenge for testCodeVerifier.
+func testCodeChallenge(t *testing.T) string {
+	t.Helper()
+	challenge, err := generateCodeChallenge(testCodeVerifier, "S256")
+	if err != nil {
+		t.Fatalf("generateCodeChallenge() error: %v", err)
+	}
+	return challenge
+}
