+// TestDCRConfidentialClientRegistration tests that DCR with a secret-based
+// token_endpoint_auth_method still generates and returns a client secret.
+func TestDCRConfidentialClientRegistration(t *testing.T) {
+	raw, client := registerDCRClient(t, `{
+		"redirect_uris": ["https://example.com/callback"],
+		"client_name": "confidential",
+		"token_endpoint_auth_method": "client_secret_post"
+	}`)
+
+	secret, ok := raw["client_secret"].(string)
+	if !ok || secret == "" {
+		t.Fatalf("expected non-empty client_secret in the response, got %v", raw["client_secret"])
+	}
+	if client.Secret != secret {
+		t.Errorf("stored Secret = %q, want the returned %q", client.Secret, secret)
+	}
+	if got, want := raw["token_endpoint_auth_method"], "client_secret_post"; got != want {
+		t.Errorf("token_endpoint_auth_method = %v, want %v", got, want)
+	}
+}
