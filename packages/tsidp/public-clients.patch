+// TestDCRPublicClientTokenFlow runs the authorization code grant through
+// serveToken for a client registered over DCR with auth method "none": the
+// token request carries only client_id and a PKCE code_verifier (any stray
+// client_secret is ignored), and PKCE is mandatory.
+func TestDCRPublicClientTokenFlow(t *testing.T) {
+	const (
+		code          = "test-code"
+		cloudRedirect = "https://cloud.example.com/oauth2-redirect"
+		labRedirect   = "http://localhost:9200/oauth2-redirect"
+	)
+
+	_, fc := registerDCRClient(t, fmt.Sprintf(`{
+		"redirect_uris": [%q, %q],
+		"client_name": "opencloud",
+		"token_endpoint_auth_method": "none",
+		"grant_types": ["authorization_code", "refresh_token"],
+		"response_types": ["code"],
+		"scope": "openid profile email"
+	}`, cloudRedirect, labRedirect))
+	if fc.Secret != "" {
+		t.Fatalf("expected DCR to store no secret for auth method none, got %q", fc.Secret)
+	}
+
+	s := New(nil, "", false, false, false)
+	s.funnelClients[fc.ID] = fc
+
+	tests := []struct {
+		name        string
+		pkce        bool
+		straySecret bool
+		wantStatus  int
+		wantErrText string
+	}{
+		{
+			name:       "token exchange with PKCE S256 verifier succeeds",
+			pkce:       true,
+			wantStatus: http.StatusOK,
+		},
+		{
+			name:        "token exchange without PKCE fails",
+			wantStatus:  http.StatusUnauthorized,
+			wantErrText: "invalid_client",
+		},
+		{
+			name:        "stray client_secret is ignored on a public client",
+			pkce:        true,
+			straySecret: true,
+			wantStatus:  http.StatusOK,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			// serveToken consumes the stored AuthRequest; insert a fresh one
+			// for every subtest.
+			ar := newPublicClientAuthRequest(fc)
+			if tt.pkce {
+				ar.CodeChallenge = testCodeChallenge(t)
+				ar.CodeChallengeMethod = "S256"
+			}
+			s.mu.Lock()
+			s.code[code] = ar
+			s.mu.Unlock()
+
+			form := url.Values{
+				"grant_type":    {"authorization_code"},
+				"code":          {code},
+				"redirect_uri":  {cloudRedirect},
+				"client_id":     {fc.ID},
+				"code_verifier": {testCodeVerifier},
+			}
+			if tt.straySecret {
+				form.Set("client_secret", "leftover-secret")
+			}
+
+			rr := httptest.NewRecorder()
+			s.serveToken(rr, postTokenForm(form))
+
+			if rr.Code != tt.wantStatus {
+				t.Errorf("expected status %d, got %d: %s", tt.wantStatus, rr.Code, rr.Body.String())
+			}
+			if tt.wantErrText != "" && !strings.Contains(rr.Body.String(), tt.wantErrText) {
+				t.Errorf("expected error containing %q, got %q", tt.wantErrText, rr.Body.String())
+			}
+			if tt.wantStatus == http.StatusOK {
+				var tokenResp oidcTokenResponse
+				if err := json.Unmarshal(rr.Body.Bytes(), &tokenResp); err != nil {
+					t.Fatalf("failed to unmarshal token response: %v", err)
+				}
+				if tokenResp.IDToken == "" || tokenResp.AccessToken == "" {
+					t.Errorf("expected non-empty id_token and access_token, got %q / %q", tokenResp.IDToken, tokenResp.AccessToken)
+				}
+			}
+		})
+	}
+}
