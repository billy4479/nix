+// SetRawServerURL sets the server URL directly, instead of deriving it from
+// the tsnet hostname. It returns an error if serverURL is not an absolute
+// http(s) URL, leaving the previous URL in place.
+func (s *IDPServer) SetRawServerURL(serverURL string) error {
+	u, err := url.Parse(serverURL)
+	if err != nil {
+		return err
+	}
+	if (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" {
+		return fmt.Errorf("server URL %q must be an absolute http(s) URL", serverURL)
+	}
+	s.serverURL = serverURL
+	return nil
+}
+
+// SetTrustedProxy sets the address of a reverse proxy in front of tsidp
+// whose X-Real-IP header is trusted for WhoIs lookups.
+func (s *IDPServer) SetTrustedProxy(addr netip.Addr) {
+	s.trustedProxy = addr
+}
+
+// whoisAddr returns the address to use for the WhoIs lookup of a request:
+// the last X-Forwarded-For hop in local tailscaled mode, the X-Real-IP when
+// the request comes from the trusted proxy, or the request's remote address
+// otherwise.
+func (s *IDPServer) whoisAddr(r *http.Request) string {
+	if s.localTSMode {
+		if addr := lastForwardedForAddr(r); addr != "" {
+			return addr
+		}
+		return r.RemoteAddr
+	}
+	if s.trustedProxy.IsValid() {
+		if ap, err := netip.ParseAddrPort(r.RemoteAddr); err == nil && ap.Addr() == s.trustedProxy {
+			if xrip := r.Header.Get("X-Real-IP"); xrip != "" {
+				if addr, err := netip.ParseAddr(xrip); err == nil {
+					return addr.String()
+				}
+			}
+		}
+	}
+	return r.RemoteAddr
+}
+
