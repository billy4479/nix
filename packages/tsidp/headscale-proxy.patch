diff --git a/server/proxy_test.go b/server/proxy_test.go
new file mode 100644
index 0000000..1ba849f
--- /dev/null
+++ b/server/proxy_test.go
@@ -0,0 +1,143 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"testing"
+)
+
+// TestWhoisAddrTrustedProxy tests that whoisAddr only honors X-Real-IP for
+// requests that come from the configured trusted proxy.
+func TestWhoisAddrTrustedProxy(t *testing.T) {
+	proxyAddr := netip.MustParseAddr("100.64.0.10")
+
+	tests := []struct {
+		name        string
+		trusted     bool
+		localTSMode bool
+		remoteAddr  string
+		xRealIP     string
+		xff         string
+		want        string
+	}{
+		{
+			name:       "honors X-Real-IP from trusted proxy",
+			trusted:    true,
+			remoteAddr: "100.64.0.10:44312",
+			xRealIP:    "100.101.102.103",
+			want:       "100.101.102.103",
+		},
+		{
+			name:       "ignores X-Real-IP from other addresses",
+			trusted:    true,
+			remoteAddr: "100.64.0.11:44312",
+			xRealIP:    "100.101.102.103",
+			want:       "100.64.0.11:44312",
+		},
+		{
+			name:       "no trusted proxy returns remote addr",
+			remoteAddr: "100.64.0.10:44312",
+			xRealIP:    "100.101.102.103",
+			want:       "100.64.0.10:44312",
+		},
+		{
+			name:       "malformed X-Real-IP returns remote addr",
+			trusted:    true,
+			remoteAddr: "100.64.0.10:44312",
+			xRealIP:    "not-an-ip",
+			want:       "100.64.0.10:44312",
+		},
+		{
+			name:        "local tailscaled mode uses X-Forwarded-For",
+			trusted:     true,
+			localTSMode: true,
+			remoteAddr:  "127.0.0.1:52000",
+			xff:         "100.64.5.6, 100.64.5.7",
+			want:        "100.64.5.7",
+		},
+		{
+			name:        "local tailscaled mode falls back to remote addr",
+			trusted:     true,
+			localTSMode: true,
+			remoteAddr:  "127.0.0.1:52000",
+			want:        "127.0.0.1:52000",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := &IDPServer{
+				localTSMode: tt.localTSMode,
+			}
+			if tt.trusted {
+				s.SetTrustedProxy(proxyAddr)
+			}
+
+			r := httptest.NewRequest("GET", "/authorize", nil)
+			r.RemoteAddr = tt.remoteAddr
+			if tt.xRealIP != "" {
+				r.Header.Set("X-Real-IP", tt.xRealIP)
+			}
+			if tt.xff != "" {
+				r.Header.Set("X-Forwarded-For", tt.xff)
+			}
+
+			if got := s.whoisAddr(r); got != tt.want {
+				t.Errorf("whoisAddr() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+// TestSetRawServerURL tests that SetRawServerURL rejects invalid URLs.
+func TestSetRawServerURL(t *testing.T) {
+	s := &IDPServer{}
+
+	const want = "https://idp.internal.polpetta.online"
+	if err := s.SetRawServerURL(want); err != nil {
+		t.Fatalf("SetRawServerURL() error: %v", err)
+	}
+	if got := s.ServerURL(); got != want {
+		t.Errorf("ServerURL() = %q, want %q", got, want)
+	}
+
+	for _, bad := range []string{"", "idp.example.com", "ftp://idp.example.com", "https://"} {
+		if err := s.SetRawServerURL(bad); err == nil {
+			t.Errorf("SetRawServerURL(%q) = nil error, want error", bad)
+		}
+	}
+}
+
+// TestSetRawServerURLIssuer tests that the URL set by SetRawServerURL is
+// advertised as the issuer in the OIDC discovery metadata.
+func TestSetRawServerURLIssuer(t *testing.T) {
+	const want = "https://idp.internal.polpetta.online"
+
+	s := &IDPServer{}
+	if err := s.SetRawServerURL(want); err != nil {
+		t.Fatalf("SetRawServerURL() error: %v", err)
+	}
+
+	req := httptest.NewRequest("GET", "/.well-known/openid-configuration", nil)
+	rr := httptest.NewRecorder()
+	s.serveOpenIDConfig(rr, req)
+
+	if rr.Code != http.StatusOK {
+		t.Fatalf("expected status 200, got %d", rr.Code)
+	}
+
+	var metadata struct {
+		Issuer string `json:"issuer"`
+	}
+	if err := json.Unmarshal(rr.Body.Bytes(), &metadata); err != nil {
+		t.Fatalf("failed to unmarshal metadata: %v", err)
+	}
+	if metadata.Issuer != want {
+		t.Errorf("issuer = %q, want %q", metadata.Issuer, want)
+	}
+}
